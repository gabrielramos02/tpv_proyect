  "fixed_sql": [
    {
      "name": "rest_tables",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rest_tables\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"top\" REAL NOT NULL, \"left\" REAL NOT NULL, \"number\" TEXT NOT NULL, \"state\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "product_types_table",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"product_types_table\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"order\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "taxes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"taxes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"rate\" REAL NOT NULL);"
        }
      ]
    },
    {
      "name": "products_class",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products_class\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"price\" REAL NOT NULL, \"color\" TEXT NOT NULL, \"order\" INTEGER NOT NULL, \"type\" INTEGER NOT NULL REFERENCES product_types_table (id), \"taxes\" INTEGER NOT NULL REFERENCES taxes (id));"
        }
      ]
    },
    {
      "name": "orders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"orders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"closed_at\" INTEGER NULL, \"total_price\" REAL NOT NULL, \"payed_price\" REAL NOT NULL, \"total_taxes\" REAL NOT NULL, \"total_price_with_taxes\" REAL NOT NULL, \"state\" INTEGER NOT NULL, \"rest_table\" INTEGER NOT NULL REFERENCES rest_tables (id));"
        }
      ]
    },
    {
      "name": "order_lines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"order_lines\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"product_name\" TEXT NOT NULL, \"current_price\" REAL NOT NULL, \"total_price\" REAL NOT NULL, \"tax_rate\" REAL NOT NULL, \"tax_price\" REAL NOT NULL, \"quantity\" INTEGER NOT NULL, \"order\" INTEGER NOT NULL REFERENCES orders (id));"
        }
      ]
    },
    {
      "name": "payments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payments\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"payment_method\" TEXT NOT NULL, \"payed_amount\" REAL NOT NULL, \"payment_date_time\" INTEGER NULL, \"order\" INTEGER NOT NULL REFERENCES orders (id));"
        }
      ]
    },
    {
      "name": "tickets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tickets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"total_price\" REAL NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    }
  ]
